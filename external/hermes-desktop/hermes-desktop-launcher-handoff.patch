+// ---------------------------------------------------------------------------
+// Launcher handoff (`hermes desktop --launcher-handoff FILE`, see
+// launcher-handoff.ts): one validated request → one fresh chat in the primary
+// renderer → exactly one ACK line. Delivery is user-initiated (the launcher
+// already took a separate confirmation), so it raises the window like a deep
+// link does. Never resubmitted: a request the renderer received but did not
+// answer before expiry is reported as `unknown`, not retried.
+// ---------------------------------------------------------------------------
+const LAUNCHER_HANDOFF_LEDGER_PATH = path.join(app.getPath('userData'), 'launcher-handoffs.json')
+// Undelivered requests give up just before expiry so the launcher still hears
+// "Desktop unavailable"; delivered ones get a short grace for the renderer's own answer.
+const LAUNCHER_HANDOFF_UNDELIVERED_LEAD_MS = 1_000
+const LAUNCHER_HANDOFF_DELIVERED_GRACE_MS = 2_000
+
+const launcherHandoffLedger = createLauncherHandoffLedger({
+  read: () => {
+    try {
+      return fs.readFileSync(LAUNCHER_HANDOFF_LEDGER_PATH, 'utf8')
+    } catch {
+      return null
+    }
+  },
+  write: contents => {
+    const tempPath = `${LAUNCHER_HANDOFF_LEDGER_PATH}.${process.pid}.tmp`
+    fs.writeFileSync(tempPath, contents, { mode: 0o600 })
+    fs.renameSync(tempPath, LAUNCHER_HANDOFF_LEDGER_PATH)
+  }
+})
+
+let _rendererReadyForLauncherHandoff = false
+const _launcherHandoffs = new Map()
+
+function finishLauncherHandoff(requestId, ack) {
+  const entry = _launcherHandoffs.get(requestId)
+
+  if (!entry) {
+    return
+  }
+
+  _launcherHandoffs.delete(requestId)
+  clearTimeout(entry.timer)
+  rememberLog(`[launcher-handoff] ${requestId} ${ack.status === 'accepted' ? `accepted ${ack.sessionId}` : ack.error}`)
+  void writeLauncherHandoffAck(entry.socketPath, { requestId, ...ack })
+}
+
+function deliverLauncherHandoff(requestId) {
+  const entry = _launcherHandoffs.get(requestId)
+
+  if (!entry || entry.delivered || !_rendererReadyForLauncherHandoff || !mainWindow || mainWindow.isDestroyed()) {
+    return
+  }
+
+  entry.delivered = true
+  clearTimeout(entry.timer)
+  entry.timer = setTimeout(
+    () => finishLauncherHandoff(requestId, { status: 'error', error: 'unknown' }),
+    Math.max(0, entry.request.expiresAt - Date.now()) + LAUNCHER_HANDOFF_DELIVERED_GRACE_MS
+  )
+  focusWindow(mainWindow)
+  mainWindow.webContents.send('hermes:launcher-handoff:request', entry.request)
+}
+
+function handleLauncherHandoff(file) {
+  const result = readLauncherHandoffRequest(file)
+
+  if (!result.ok) {
+    rememberLog(`[launcher-handoff] refused ${result.requestId || 'request'}: ${result.error}`)
+
+    if (result.socketPath && result.requestId) {
+      void writeLauncherHandoffAck(result.socketPath, {
+        requestId: result.requestId,
+        status: 'error',
+        error: result.error
+      })
+    }
+
+    return
+  }
+
+  const { request, socketPath } = result
+  let claimed
+
+  try {
+    claimed = launcherHandoffLedger.claim(request.requestId)
+  } catch (error) {
+    rememberLog(`[launcher-handoff] could not record ${request.requestId}: ${error.message}`)
+    void writeLauncherHandoffAck(socketPath, { requestId: request.requestId, status: 'error', error: 'desktop' })
+
+    return
+  }
+
+  if (!claimed) {
+    rememberLog(`[launcher-handoff] refused duplicate ${request.requestId}`)
+    void writeLauncherHandoffAck(socketPath, { requestId: request.requestId, status: 'error', error: 'rejected' })
+
+    return
+  }
+
+  const timer = setTimeout(
+    () => finishLauncherHandoff(request.requestId, { status: 'error', error: 'desktop' }),
+    Math.max(0, request.expiresAt - Date.now() - LAUNCHER_HANDOFF_UNDELIVERED_LEAD_MS)
+  )
+
+  _launcherHandoffs.set(request.requestId, { delivered: false, request, socketPath, timer })
+  deliverLauncherHandoff(request.requestId)
+}
+
+ipcMain.handle('hermes:launcher-handoff:ready', event => {
+  if (!mainWindow || mainWindow.isDestroyed() || event.sender !== mainWindow.webContents) {
+    return { ok: false }
+  }
