+  _rendererReadyForLauncherHandoff = true
+
+  for (const requestId of [..._launcherHandoffs.keys()]) {
+    deliverLauncherHandoff(requestId)
+  }
+
+  return { ok: true }
+})
+
+ipcMain.handle('hermes:launcher-handoff:result', (event, result) => {
+  if (!mainWindow || mainWindow.isDestroyed() || event.sender !== mainWindow.webContents) {
+    return
+  }
+
+  const requestId = typeof result?.requestId === 'string' ? result.requestId : ''
+
+  if (!_launcherHandoffs.get(requestId)?.delivered) {
+    return
+  }
+
+  const sessionId = typeof result.sessionId === 'string' ? result.sessionId : ''
