+describe('usePromptActions launcher exact handoff', () => {
+  afterEach(() => {
+    cleanup()
+    $hudMode.set(false)
+    vi.restoreAllMocks()
+  })
+
+  async function handoff(text: string, submitResult: () => Promise<unknown>) {
+    $hudMode.set(true)
+    const activeSessionIdRef = { current: null as null | string }
+    const selectedStoredSessionIdRef = { current: null as null | string }
+    const creates: (SessionCreateOverrides | undefined)[] = []
+    const submits: (Record<string, unknown> | undefined)[] = []
+    const events: string[] = []
+
+    const requestGateway = vi.fn(async (method: string, params?: Record<string, unknown>) => {
+      if (method === 'prompt.submit') {
+        submits.push(params)
+
+        return submitResult() as never
+      }
+
+      return {} as never
+    })
+
+    let handle: HarnessHandle | null = null
+    await actRender(
+      <Harness
+        activeSessionId={null}
+        activeSessionIdRef={activeSessionIdRef}
+        createBackendSessionForSend={async (_preview, overrides) => {
+          creates.push(overrides)
+          activeSessionIdRef.current = 'rt-new'
+          selectedStoredSessionIdRef.current = 'stored-new'
+
+          return 'rt-new'
+        }}
+        onReady={h => (handle = h)}
+        refreshSessions={async () => undefined}
+        requestGateway={requestGateway}
+        selectedStoredSessionIdRef={selectedStoredSessionIdRef}
+        storedSessionId={null}
+      />
+    )
+
+    const ok = await handle!.submitText(text, {
+      exactHandoff: {
+        model: 'gpt-6.1-sol',
+        onSubmitted: ids => void events.push(`submitted:${ids.storedSessionId}:${ids.runtimeSessionId}`),
+        onSubmitting: () => void events.push('submitting'),
+        provider: 'openai-codex'
+      }
+    })
+
+    return { creates, events, ok, submits }
+  }
+
+  it('sends the typed text verbatim into a fresh chat with a per-session model', async () => {
+    const text = '  /yolo is data here; "quoted" $(not run)  \n'
+    const { creates, events, ok, submits } = await handoff(text, async () => ({ status: 'streaming' }))
+
+    expect(ok).toBe(true)
+    expect(creates).toEqual([{ allowYolo: false, model: 'gpt-6.1-sol', provider: 'openai-codex' }])
+    expect(submits).toEqual([{ session_id: 'rt-new', text }])
+    expect(events).toEqual(['submitting', 'submitted:stored-new:rt-new'])
+  })
+
+  it('attempts prompt.submit once and never reports success when it fails', async () => {
+    const { events, submits } = await handoff('Reply exactly: ok', async () => {
+      throw new Error('request timed out')
+    })
+
+    expect(submits).toHaveLength(1)
+    expect(events).toEqual(['submitting'])
+  })
+})
