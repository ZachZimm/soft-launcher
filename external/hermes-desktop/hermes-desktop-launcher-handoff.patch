+      runtimeSessionId,
+      // The gateway issues no turn id; this names the fresh chat's first user turn.
+      turnId: `${sessionId}:user:1`
+    })
+
+    return
+  }
+
+  const error = ['desktop', 'rejected', 'unsupported'].includes(result.error) ? result.error : 'unknown'
+  finishLauncherHandoff(requestId, { status: 'error', error })
+})
