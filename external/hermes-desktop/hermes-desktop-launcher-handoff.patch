@@ -0,0 +1,278 @@
+/**
+ * Launcher handoff — a local launcher asks Desktop to open a NEW chat with an
+ * exact, user-confirmed task (`hermes desktop --launcher-handoff FILE`).
+ *
+ * The launcher owns a private per-request directory holding `request.json`
+ * and a Unix socket `ack.sock`. Desktop reads the request once, dispatches it
+ * to the primary renderer (which submits through the normal prompt path, with
+ * the user's normal approvals), and writes exactly one JSON line back to the
+ * socket: accepted (with session ids) or an error code. The task text never
+ * goes back over the socket or into logs.
+ *
+ * Everything here is Electron-free so the parts that protect the user — file
+ * ownership checks, expiry, duplicate refusal, and the exact-text guarantee —
+ * are testable in node. main.ts owns delivery and the renderer round trip.
+ */
+import fs from 'node:fs'
+import net from 'node:net'
+import path from 'node:path'
+
+export const LAUNCHER_HANDOFF_SWITCH = '--hermes-launcher-handoff='
+export const LAUNCHER_HANDOFF_HANDLER = 'hermes-desktop-launcher-handoff'
+
+const REQUEST_FILE = 'request.json'
+const REPLY_SOCKET = 'ack.sock'
+const MAX_REQUEST_BYTES = 64 * 1024
+const MAX_TEXT_BYTES = 4096
+const MAX_LIFETIME_MS = 120_000
+const ACK_WRITE_TIMEOUT_MS = 2_000
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
+const MODEL_RE = /^[A-Za-z0-9._:/-]{1,128}$/
+const ALLOWED_PROVIDERS = new Set(['openai-codex'])
+
+export type LauncherHandoffError = 'desktop' | 'rejected' | 'unknown' | 'unsupported'
+
+export interface LauncherHandoffRequest {
+  expiresAt: number
+  model: string
+  provider: string
+  requestId: string
+  text: string
+}
+
+export type LauncherHandoffAck =
+  | {
+      requestId: string
+      runtimeSessionId: string
+      sessionId: string
+      status: 'accepted'
+      turnId: string
+    }
+  | { error: LauncherHandoffError; requestId: string; status: 'error' }
+
+/** `request` is set only when `ok`; `socketPath` only when the reply socket itself validated. */
+export interface ReadResult {
+  error?: LauncherHandoffError
+  ok: boolean
+  request?: LauncherHandoffRequest
+  requestId?: string
+  socketPath?: string
+}
+
+/** The request file named on an argv (cold start or `second-instance`), or null. */
+export function launcherHandoffPathFromArgv(argv: readonly unknown[] | null | undefined): null | string {
+  const arg = (argv ?? []).find(a => typeof a === 'string' && a.startsWith(LAUNCHER_HANDOFF_SWITCH))
+
+  return typeof arg === 'string' ? arg.slice(LAUNCHER_HANDOFF_SWITCH.length) || null : null
+}
+
+// Mirrors hermes_cli/input_sanitize.py. The backend applies it to every
+// prompt, so a launcher task it would rewrite is refused instead of being
+// silently changed — accepted means byte-exact.
+const BOUNDARY_SUBS: [RegExp, string][] = [
+  [/(^|[\s\n>:\])])\[200~/g, '$1'],
+  [/\[201~(?=$|[\s\n<[():;.,!?])/g, ''],
+  [/(^|[\s\n>:\])])00~/g, '$1'],
+  [/01~(?=$|[\s\n<[():;.,!?])/g, '']
+]
+
+const PASTE_ARTIFACT = '~[[e'
+
+export function backendWouldRewrite(text: string): boolean {
+  let next = text
+
+  for (const wrapper of ['\x1b[200~', '\x1b[201~', '^[[200~', '^[[201~']) {
+    next = next.split(wrapper).join('')
+  }
+
+  for (const [pattern, repl] of BOUNDARY_SUBS) {
+    next = next.replace(pattern, repl)
+  }
+
+  if (next !== text) {
+    return true
+  }
+
+  let repeats = 0
+
+  for (let end = text.length; end >= PASTE_ARTIFACT.length; end -= PASTE_ARTIFACT.length) {
+    if (text.slice(end - PASTE_ARTIFACT.length, end) !== PASTE_ARTIFACT) {
+      break
+    }
+
+    repeats += 1
+  }
+
+  return repeats >= 4
+}
+
+function ownedBy(st: fs.Stats, uid: number, mode: number): boolean {
+  return st.uid === uid && (st.mode & 0o777) === mode
+}
+
+/**
+ * Validate and consume a request file. The file is unlinked once read so a
+ * request can be dispatched at most once even if the same path is delivered
+ * twice. `socketPath` is returned only when the reply socket itself passed
+ * validation; without it the caller must not write anything.
+ */
+export function readLauncherHandoffRequest(
+  file: string,
+  { now = Date.now(), uid = process.getuid?.() ?? -1 }: { now?: number; uid?: number } = {}
+): ReadResult {
+  if (!path.isAbsolute(file) || path.basename(file) !== REQUEST_FILE || path.normalize(file) !== file) {
+    return { error: 'rejected', ok: false }
+  }
+
+  const dir = path.dirname(file)
+  const socketPath = path.join(dir, REPLY_SOCKET)
+  let socketOk = false
+
+  try {
+    const dirSt = fs.lstatSync(dir)
+
+    if (!dirSt.isDirectory() || !ownedBy(dirSt, uid, 0o700)) {
+      return { error: 'rejected', ok: false }
+    }
+
+    const sockSt = fs.lstatSync(socketPath)
+    socketOk = sockSt.isSocket() && sockSt.uid === uid
+  } catch {
+    return { error: 'rejected', ok: false }
+  }
+
+  const reply = socketOk ? { socketPath } : {}
+  let raw: string
+
+  try {
+    const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW)
+
+    try {
+      const st = fs.fstatSync(fd)
+
+      if (!st.isFile() || !ownedBy(st, uid, 0o600) || st.size > MAX_REQUEST_BYTES) {
+        return { error: 'rejected', ok: false, ...reply }
+      }
+
+      raw = fs.readFileSync(fd, 'utf8')
+    } finally {
+      fs.closeSync(fd)
+    }
+
+    fs.unlinkSync(file)
+  } catch {
+    return { error: 'rejected', ok: false, ...reply }
+  }
+
+  let body: Record<string, unknown>
+
+  try {
+    body = JSON.parse(raw)
+  } catch {
+    return { error: 'rejected', ok: false, ...reply }
+  }
+
+  const requestId = typeof body?.requestId === 'string' && UUID_RE.test(body.requestId) ? body.requestId : undefined
+
+  if (!requestId) {
+    return { error: 'rejected', ok: false, ...reply }
+  }
+
+  const fail = (error: LauncherHandoffError): ReadResult => ({ error, ok: false, requestId, ...reply })
+
+  if (body.version !== 1) {
+    return fail('unsupported')
+  }
+
+  if (body.replySocket !== socketPath || !socketOk) {
+    return { error: 'rejected', ok: false, requestId }
+  }
+
+  const { expiresAt, model, provider, text } = body
+
+  if (typeof expiresAt !== 'number' || !Number.isFinite(expiresAt) || expiresAt <= now) {
+    return fail('rejected')
+  }
+
+  if (expiresAt > now + MAX_LIFETIME_MS) {
+    return fail('rejected')
+  }
+
+  if (typeof provider !== 'string' || !ALLOWED_PROVIDERS.has(provider)) {
+    return fail('unsupported')
+  }
+
+  if (typeof model !== 'string' || !MODEL_RE.test(model)) {
+    return fail('unsupported')
+  }
+
+  if (
+    typeof text !== 'string' ||
+    !text.trim() ||
+    text.includes('\0') ||
+    Buffer.byteLength(text, 'utf8') > MAX_TEXT_BYTES ||
+    backendWouldRewrite(text)
+  ) {
+    return fail('rejected')
+  }
+
+  return { ok: true, request: { expiresAt, model, provider, requestId, text }, socketPath }
+}
+
+/**
+ * Remembers request ids already dispatched, persisted so a relaunch cannot
+ * replay one. Bounded: the oldest ids fall off, and expiry (≤ 2 minutes)
+ * refuses anything that old anyway.
+ */
+export function createLauncherHandoffLedger(
+  store: { read: () => null | string; write: (contents: string) => void },
+  limit = 200
+) {
+  const load = (): string[] => {
+    try {
+      const parsed = JSON.parse(store.read() || '[]')
+
+      return Array.isArray(parsed) ? parsed.filter((id): id is string => typeof id === 'string') : []
+    } catch {
+      return []
+    }
+  }
+
+  return {
+    /** True the first time an id is claimed; false for every later claim. */
+    claim(requestId: string): boolean {
+      const ids = load()
+
+      if (ids.includes(requestId)) {
+        return false
+      }
+
+      store.write(JSON.stringify([...ids, requestId].slice(-limit)))
+
+      return true
+    }
+  }
+}
+
+/** Write one ACK line to the launcher's socket. Never throws. */
+export function writeLauncherHandoffAck(socketPath: string, ack: LauncherHandoffAck): Promise<boolean> {
+  const line = `${JSON.stringify({ version: 1, handler: LAUNCHER_HANDOFF_HANDLER, ...ack })}\n`
+
+  return new Promise(resolve => {
+    let settled = false
+
+    const done = (ok: boolean) => {
+      if (!settled) {
+        settled = true
+        clearTimeout(timer)
+        socket.destroy()
+        resolve(ok)
+      }
+    }
+
+    const socket = net.createConnection(socketPath)
+    const timer = setTimeout(() => done(false), ACK_WRITE_TIMEOUT_MS)
+    socket.once('error', () => done(false))
+    socket.once('connect', () => socket.end(line, () => done(true)))
+  })
+}
