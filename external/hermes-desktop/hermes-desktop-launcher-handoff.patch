@@ -0,0 +1,142 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import net from 'node:net'
+import os from 'node:os'
+import path from 'node:path'
+
+import { afterEach, beforeEach, test } from 'vitest'
+
+import {
+  backendWouldRewrite,
+  createLauncherHandoffLedger,
+  launcherHandoffPathFromArgv,
+  readLauncherHandoffRequest,
+  writeLauncherHandoffAck
+} from './launcher-handoff'
+
+const REQUEST_ID = '0f8fad5b-d9cb-469f-a165-70867728950e'
+const NOW = 1_800_000_000_000
+
+let dir: string
+let server: net.Server
+let received: Promise<string>
+
+beforeEach(async () => {
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), 'slhd-'))
+  fs.chmodSync(dir, 0o700)
+  received = new Promise(resolve => {
+    server = net.createServer(conn => {
+      let data = ''
+      conn.on('data', chunk => (data += chunk))
+      conn.on('end', () => resolve(data))
+    })
+  })
+  await new Promise<void>(resolve => server.listen(path.join(dir, 'ack.sock'), resolve))
+})
+
+afterEach(() => {
+  server.close()
+  fs.rmSync(dir, { force: true, recursive: true })
+})
+
+function writeRequest(fields: Record<string, unknown> = {}, mode = 0o600): string {
+  const file = path.join(dir, 'request.json')
+
+  fs.writeFileSync(
+    file,
+    JSON.stringify({
+      version: 1,
+      requestId: REQUEST_ID,
+      text: '  /yolo keep "quotes" $(and) spaces  \n',
+      replySocket: path.join(dir, 'ack.sock'),
+      expiresAt: NOW + 42_000,
+      provider: 'openai-codex',
+      model: 'gpt-6.1-sol',
+      ...fields
+    }),
+    { mode }
+  )
+  fs.chmodSync(file, mode)
+
+  return file
+}
+
+test('a valid request is read verbatim exactly once', () => {
+  const file = writeRequest()
+  const argv = ['/opt/Hermes', '--no-sandbox', `--hermes-launcher-handoff=${file}`]
+
+  assert.equal(launcherHandoffPathFromArgv(argv), file)
+
+  const first = readLauncherHandoffRequest(file, { now: NOW })
+
+  assert.equal(first.ok, true)
+  assert.equal(first.request?.text, '  /yolo keep "quotes" $(and) spaces  \n', 'no trimming or reinterpretation')
+  assert.equal(first.socketPath, path.join(dir, 'ack.sock'))
+  assert.equal(fs.existsSync(file), false, 'consumed on read')
+  assert.equal(readLauncherHandoffRequest(file, { now: NOW }).ok, false, 'a second delivery of the path dispatches nothing')
+})
+
+test('unsafe or stale requests are refused without dispatch', () => {
+  const cases: [string, () => string][] = [
+    ['group/world readable file', () => writeRequest({}, 0o644)],
+    ['expired', () => writeRequest({ expiresAt: NOW - 1 })],
+    ['expiry too far ahead', () => writeRequest({ expiresAt: NOW + 10 * 60_000 })],
+    ['foreign reply socket', () => writeRequest({ replySocket: '/tmp/elsewhere.sock' })],
+    ['provider other than the launcher one', () => writeRequest({ provider: 'openrouter' })],
+    ['blank text', () => writeRequest({ text: '   ' })],
+    ['NUL in text', () => writeRequest({ text: 'a\0b' })],
+    ['over 4096 bytes', () => writeRequest({ text: 'é'.repeat(2049) })],
+    ['text the backend sanitizer would rewrite', () => writeRequest({ text: 'hi \x1b[200~there' })]
+  ]
+
+  for (const [label, make] of cases) {
+    const result = readLauncherHandoffRequest(make(), { now: NOW })
+
+    assert.equal(result.ok, false, label)
+    assert.equal(result.request, undefined, label)
+  }
+
+  const link = path.join(dir, 'request.json')
+  fs.rmSync(link, { force: true })
+  fs.symlinkSync(writeRequestElsewhere(), link)
+  assert.equal(readLauncherHandoffRequest(link, { now: NOW }).ok, false, 'symlinked request file')
+})
+
+function writeRequestElsewhere(): string {
+  const other = path.join(dir, 'other.json')
+  fs.writeFileSync(other, '{}', { mode: 0o600 })
+
+  return other
+}
+
+test('the ledger lets each request id through once, across reloads', () => {
+  let stored: null | string = null
+  const store = { read: () => stored, write: (contents: string) => void (stored = contents) }
+
+  assert.equal(createLauncherHandoffLedger(store).claim(REQUEST_ID), true)
+  assert.equal(createLauncherHandoffLedger(store).claim(REQUEST_ID), false, 'fresh ledger over the same file')
+})
+
+test('the ACK is one marked JSON line without the task text', async () => {
+  const ok = await writeLauncherHandoffAck(path.join(dir, 'ack.sock'), {
+    requestId: REQUEST_ID,
+    runtimeSessionId: 'rt-1',
+    sessionId: '20261018_120000_abcdef',
+    status: 'accepted',
+    turnId: '20261018_120000_abcdef:user:1'
+  })
+
+  assert.equal(ok, true)
+  const line = await received
+  assert.ok(line.endsWith('\n') && line.indexOf('\n') === line.length - 1)
+  assert.deepEqual(JSON.parse(line), {
+    version: 1,
+    handler: 'hermes-desktop-launcher-handoff',
+    requestId: REQUEST_ID,
+    runtimeSessionId: 'rt-1',
+    sessionId: '20261018_120000_abcdef',
+    status: 'accepted',
+    turnId: '20261018_120000_abcdef:user:1'
+  })
+  assert.equal(backendWouldRewrite('literal[200~tag stays'), false)
+})
diff --git a/apps/desktop/src/app/contrib/hooks/use-launcher-handoff-bridge.ts b/apps/desktop/src/app/contrib/hooks/use-launcher-handoff-bridge.ts
new file mode 100644
index 0000000000..c79696354a
--- /dev/null
+++ b/apps/desktop/src/app/contrib/hooks/use-launcher-handoff-bridge.ts
@@ -0,0 +1,139 @@
+import { useEffect, useRef } from 'react'
+
+import { NEW_CHAT_ROUTE } from '@/app/routes'
+import type { SubmitTextOptions } from '@/app/session/hooks/use-prompt-actions/utils'
+import {
+  LAUNCHER_HANDOFF_SUBMIT_RESERVE_MS,
+  type LauncherHandoffRequest,
+  launcherHandoffResult,
+  type LauncherSubmitIds
+} from '@/lib/launcher-handoff'
+import { $gatewayState } from '@/store/session'
+import { isAuxiliaryWindow } from '@/store/windows'
+
+interface LauncherHandoffBridgeParams {
+  getRouteToken: () => string
+  startFreshSessionDraft: () => void
+  submitText: (text: string, options?: SubmitTextOptions) => Promise<unknown> | unknown
+}
+
+// The fresh draft's navigation publishes on the next render; submitting before
+// that reads as a mid-create session switch and the send is aborted.
+const FRESH_ROUTE_WAIT_MS = 2_000
+
+function waitForFreshRoute(getRouteToken: () => string): Promise<void> {
+  const deadline = Date.now() + FRESH_ROUTE_WAIT_MS
+
+  return new Promise(resolve => {
+    const check = () => {
+      if (getRouteToken().split(':')[0] === NEW_CHAT_ROUTE || Date.now() > deadline) {
+        resolve()
+      } else {
+        // Timers, not animation frames: frames pause in a hidden or minimized window.
+        window.setTimeout(check, 16)
+      }
+    }
+
+    check()
+  })
+}
+
+function waitForGatewayOpen(deadline: number): Promise<boolean> {
+  if ($gatewayState.get() === 'open') {
+    return Promise.resolve(true)
+  }
+
+  return new Promise(resolve => {
+    const timer = window.setTimeout(() => finish(false), Math.max(0, deadline - Date.now()))
+
+    const off = $gatewayState.listen(state => {
+      if (state === 'open') {
+        finish(true)
+      }
+    })
+
+    function finish(open: boolean) {
+      window.clearTimeout(timer)
+      off()
+      resolve(open)
+    }
+  })
+}
+
+/**
+ * A launcher task (`hermes desktop --launcher-handoff`) becomes a NEW chat,
+ * exactly like clicking New Chat and typing it — same session create, same
+ * submit, same approvals — except the text is sent verbatim (no slash-command
+ * routing, trimming, terminal context or staged attachments), the model is a
+ * per-session pick, and `prompt.submit` is attempted once. The launcher
+ * already took the user's confirmation, so this answers main exactly once per
+ * request id and never resubmits.
+ *
+ * Primary window only, registered once through refs (see use-quick-entry-bridge).
+ */
+export function useLauncherHandoffBridge({
+  getRouteToken,
+  startFreshSessionDraft,
+  submitText
+}: LauncherHandoffBridgeParams): void {
+  const getRouteTokenRef = useRef(getRouteToken)
+  getRouteTokenRef.current = getRouteToken
+  const submitTextRef = useRef(submitText)
+  submitTextRef.current = submitText
+  const startFreshRef = useRef(startFreshSessionDraft)
+  startFreshRef.current = startFreshSessionDraft
+
+  useEffect(() => {
+    const api = window.hermesDesktop?.launcherHandoff
+
+    if (isAuxiliaryWindow() || !api) {
+      return
+    }
+
+    const seen = new Set<string>()
+
+    const handle = async (request: LauncherHandoffRequest) => {
+      if (seen.has(request.requestId)) {
+        return
+      }
+
+      seen.add(request.requestId)
+
+      if (!(await waitForGatewayOpen(request.expiresAt - LAUNCHER_HANDOFF_SUBMIT_RESERVE_MS))) {
+        await api.result({ error: 'desktop', requestId: request.requestId, status: 'error' })
+
+        return
+      }
+
+      let ids: LauncherSubmitIds | null = null
+      let submitting = false
+
+      startFreshRef.current()
+      await waitForFreshRoute(() => getRouteTokenRef.current())
+
+      try {
+        await submitTextRef.current(request.text, {
+          exactHandoff: {
+            model: request.model,
+            onSubmitted: submitted => {
+              ids = submitted
+            },
+            onSubmitting: () => {
+              submitting = true
+            },
+            provider: request.provider
+          }
+        })
+      } catch {
+        // Reported below from what was observed; a throw after prompt.submit is ambiguous.
+      }
+
+      await api.result(launcherHandoffResult(request.requestId, { ids, submitting }))
+    }
+
+    const unsubscribe = api.onRequest(request => void handle(request))
+    void api.ready()
+
+    return unsubscribe
+  }, [])
+}
diff --git a/apps/desktop/src/lib/launcher-handoff.ts b/apps/desktop/src/lib/launcher-handoff.ts
new file mode 100644
index 0000000000..a8deeb6ec0
--- /dev/null
+++ b/apps/desktop/src/lib/launcher-handoff.ts
@@ -0,0 +1,41 @@
+/** A launcher task main validated and forwarded (see electron/launcher-handoff.ts). */
+export interface LauncherHandoffRequest {
+  expiresAt: number
+  model: string
+  provider: string
+  requestId: string
+  text: string
+}
+
+export type LauncherHandoffResult =
+  | { requestId: string; runtimeSessionId: string; sessionId: string; status: 'accepted' }
+  | { error: 'desktop' | 'rejected' | 'unknown'; requestId: string; status: 'error' }
+
+export interface LauncherSubmitIds {
+  runtimeSessionId: string
+  storedSessionId: string
+}
+
+/** Leave this much of the request's lifetime for the submit itself. */
+export const LAUNCHER_HANDOFF_SUBMIT_RESERVE_MS = 10_000
+
+/**
+ * How a finished launcher submit is reported. Once `prompt.submit` has been
+ * sent, a failure is ambiguous (the turn may have started), so it is `unknown`
+ * — never `rejected`, which tells the launcher nothing ran.
+ */
+export function launcherHandoffResult(
+  requestId: string,
+  { ids, submitting }: { ids: LauncherSubmitIds | null; submitting: boolean }
+): LauncherHandoffResult {
+  if (ids?.storedSessionId && ids.runtimeSessionId) {
+    return {
+      requestId,
+      runtimeSessionId: ids.runtimeSessionId,
+      sessionId: ids.storedSessionId,
+      status: 'accepted'
+    }
+  }
+
+  return { error: submitting ? 'unknown' : 'rejected', requestId, status: 'error' }
+}
diff --git a/tests/hermes_cli/test_desktop_launcher_handoff.py b/tests/hermes_cli/test_desktop_launcher_handoff.py
new file mode 100644
index 0000000000..a0f6993372
--- /dev/null
+++ b/tests/hermes_cli/test_desktop_launcher_handoff.py
@@ -0,0 +1,64 @@
+"""``hermes desktop --launcher-handoff FILE`` reaches Electron as one switch.
+
+Electron (apps/desktop/electron/launcher-handoff.ts) owns validation of the
+request file; the CLI's job is only to forward it — to a fresh app or, via
+Electron's single-instance lock, to the one already running.
+"""
+
+import argparse
+import subprocess
+
+import pytest
+
+from hermes_cli import main as cli_main
+from hermes_cli import main_desktop
+from hermes_cli.subcommands.gui import build_gui_parser
+
+
+def _args(argv):
+    parser = argparse.ArgumentParser(prog="hermes")
+    build_gui_parser(parser.add_subparsers(dest="command"), cmd_gui=main_desktop.cmd_gui)
+    return parser.parse_args(argv)
+
+
+@pytest.fixture
+def launches(tmp_path, monkeypatch):
+    root = tmp_path / "hermes-agent"
+    (root / "apps" / "desktop").mkdir(parents=True)
+    (root / "apps" / "desktop" / "package.json").write_text("{}", encoding="utf-8")
+    exe = root / "apps" / "desktop" / "release" / "linux-unpacked" / "Hermes"
+    monkeypatch.setattr(cli_main, "PROJECT_ROOT", root)
+    monkeypatch.setenv("XDG_DATA_HOME", str(tmp_path / "xdg-data"))
+    monkeypatch.setenv("HERMES_DESKTOP_PASSWORD_STORE", "basic")
+    monkeypatch.setattr(main_desktop, "_desktop_packaged_executable", lambda d: exe)
+    monkeypatch.setattr(main_desktop, "_packaged_desktop_launch_command", lambda e: [str(e)])
+    monkeypatch.setattr(main_desktop, "_register_linux_desktop_entry", lambda: None)
+    calls = []
+
+    def fake_run(cmd, **kwargs):
+        calls.append(list(cmd))
+        return subprocess.CompletedProcess(cmd, 0)
+
+    monkeypatch.setattr(main_desktop.subprocess, "run", fake_run)
+    return exe, calls
+
+
+def test_handoff_file_is_forwarded_as_a_single_electron_switch(launches, tmp_path):
+    exe, calls = launches
+    request = str(tmp_path / "slhd-x" / "request.json")
+
+    with pytest.raises(SystemExit) as exc:
+        main_desktop.cmd_gui(_args(["desktop", "--skip-build", "--launcher-handoff", request]))
+
+    assert exc.value.code == 0
+    assert calls == [[str(exe), f"--hermes-launcher-handoff={request}"]]
+
+
+def test_relative_handoff_path_is_refused_before_anything_launches(launches):
+    _, calls = launches
+
+    with pytest.raises(SystemExit) as exc:
+        main_desktop.cmd_gui(_args(["desktop", "--skip-build", "--launcher-handoff", "request.json"]))
+
+    assert exc.value.code == 2
+    assert calls == []
