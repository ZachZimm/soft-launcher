# Public build defaults consumed by Vite. Never put credentials in VITE_* variables.
VITE_DECISION_KIND=ollama
VITE_DECISION_URL=http://127.0.0.1:11434
VITE_DECISION_MODEL=clef-flash-q8:latest
VITE_DECISION_LABEL=this computer

# A remote URL also needs a matching exact-origin Tauri CSP override.
# See src-tauri/README.md. Native environment settings do not belong here;
# Vite does not export this file to the native process or systemd service.
