# Track the Hermes patch and provenance, not packaged binaries.
/external/hermes-desktop/candidate-release/
/external/hermes-desktop/deployment-*.json
/external/launcher-ui-frozen.sha256
/external/launcher-ui-base/

# Private historical notes, transcripts, local manifests and publication evidence.
/.private-archive/
/publication-audit*.json
/external/hermes-desktop/MANIFEST.local.json

# Local exact-origin CSP overrides and service build inputs.
/src-tauri/tauri.*.local.json
