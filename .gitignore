# Generated validation captures and local installation records remain private.
/HERMES-CODEX-INSTALL.json
/STARTUP-VALIDATION.json
/scripts/*.json
/scripts/fixtures/routing-*.json
!/scripts/fixtures/routing-baseline-questions.json
!/scripts/fixtures/routing-live-regressions.json
